# Porta HTTP do servidor
PORT=3000

# Conexão com o PostgreSQL
DATABASE_URL=postgres://natal:troque-esta-senha@localhost:5432/pesquisa_natal
# Use true para bancos gerenciados que exigem SSL (ex.: RDS, Azure, Render, Neon)
DATABASE_SSL=false

# Senha única da área administrativa (/admin)
ADMIN_PASSWORD=troque-esta-senha-do-admin

# Segredo para assinar os cookies (gere um valor longo e aleatório):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Duração da sessão do administrador, em horas
ADMIN_SESSION_HOURS=8

# Opcional: data/hora em que a votação encerra (formato ISO com fuso)
# VOTACAO_ENCERRA_EM=2026-12-05T23:59:59-03:00

# Opcional: sugestões de setor exibidas no formulário (separadas por vírgula)
# SETORES=Administrativo,Comercial,Financeiro,Logística,Manutenção,Marketing,Produção,Qualidade,Recursos Humanos,TI

# Fuso usado em "votos hoje" e nas datas do CSV
FUSO_HORARIO=America/Sao_Paulo

# Se estiver atrás de proxy reverso (Nginx, IIS, load balancer), informe 1
# TRUST_PROXY=1
